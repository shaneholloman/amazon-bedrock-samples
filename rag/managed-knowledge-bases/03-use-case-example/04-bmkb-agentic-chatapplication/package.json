{
  "name": "bmkb-doc-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant document upload + agentic chat on Amazon Bedrock Knowledge Base (single-KB, multi-tenant via inline metadata + explicit retrieval filter). MKB-API-compatible.",
  "license": "MIT-0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "deploy",
    "lambda/*",
    "lambda/common",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --verbose",
    "lint": "npm run lint --workspaces --if-present",
    "synth": "npm run synth --workspace deploy",
    "deploy": "npm run deploy --workspace deploy",
    "destroy": "npm run destroy --workspace deploy"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": "^6.4.3"
  }
}
