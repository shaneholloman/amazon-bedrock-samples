# ---------------------------------------------------------------------------
# bmkb-doc-chat — environment template. Copy to .env (gitignored) and fill in.
# NOTE: the VITE_-prefixed vars are a LOCAL-DEV fallback only (used by
# `npm run dev`). A DEPLOYED frontend does NOT read them: it fetches its config
# at runtime from /config.json, written by `cdk deploy` from the stack outputs.
# The dev-only fallback path is tree-shaken out of production builds, so nothing
# here is baked into a deployed bundle. Never put browser-secret material here.
# ---------------------------------------------------------------------------

# --- AWS / deploy ---------------------------------------------------------
AWS_REGION=us-west-2
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-west-2

# --- Bedrock Knowledge Base ----------------------------------------------
# Set after `npm run deploy` (CDK outputs these). App code reads KB_ID + DS_ID.
# The KB is a TRUE Managed KB (type=MANAGED): Bedrock manages the vector store
# AND embeddings — there is no embedding-model ARN to configure. See
# the README (Design decisions).
KB_ID=
DATA_SOURCE_ID=
# Model the chat lambda's IAM grant scopes InvokeModel to. Agentic retrieval
# uses foundationModelType=MANAGED (Bedrock picks the model), so this is only
# the least-privilege grant target. Use a current inference profile (the legacy
# claude-3-5 on-demand ARNs are end-of-life).
GENERATION_MODEL_ARN=arn:aws:bedrock:us-west-2:123456789012:inference-profile/us.anthropic.claude-sonnet-4-6

# --- Storage / queue / status --------------------------------------------
DOCUMENTS_BUCKET=
INGEST_QUEUE_URL=
INGEST_DLQ_URL=
STATUS_TABLE=bmkb-doc-status
RATE_TABLE=bmkb-rate-tokens

# --- Rate limiter (config-driven; HARD ceilings from verified Service Quotas)
# Files per IngestKnowledgeBaseDocuments request — MKB quota L-30E8CCBD = 10.
INGEST_BATCH_MAX=10
# IngestKnowledgeBaseDocuments TPS (doc-only, F2). Token-bucket refill rate.
INGEST_MAX_TPS=5
# Concurrent Ingest+Delete per ACCOUNT (shared, non-adjustable, F4).
INGEST_MAX_CONCURRENCY=10
# Inline payload ceiling per request (doc-only, F3) in bytes = 6 MB.
INLINE_MAX_BYTES=6291456
# Per-file size limit on the S3 path (F5) in bytes = 50 MB.
S3_MAX_FILE_BYTES=52428800

# --- Multitenancy ---------------------------------------------------------
# Plain metadata key — NEVER prefix with underscore (reserved on managed KB, F12).
TENANT_METADATA_KEY=tenant_id

# --- Frontend (LOCAL DEV ONLY; no secrets) -------------------------------
# These are consumed ONLY by `npm run dev`. A deployed frontend ignores them and
# reads /config.json instead. The Cognito SPA app client has NO client secret
# (correct for a browser app); the only sensitive material is the user's token,
# obtained at runtime via Authorization Code + PKCE.
VITE_API_BASE=https://your-api-id.execute-api.us-west-2.amazonaws.com/prod

# Cognito hosted-UI sign-in (Authorization Code + PKCE). Set after deploy.
#   AUTHORITY = the user-pool issuer URL
#   CLIENT_ID = the public SPA app client id (no secret)
#   DOMAIN    = the hosted-UI domain (used for RP-initiated logout)
# The OAuth redirect URI is always derived from the app origin at runtime
# (window.location.origin + '/'), so there is nothing to configure here.
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=your-app-client-id
VITE_COGNITO_DOMAIN=https://your-prefix.auth.us-west-2.amazoncognito.com
